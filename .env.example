# Copy to `.env` and fill in with values from your Supabase project
# (Dashboard → Project Settings → API).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Public half of the VAPID key pair used for Web Push.
# Generate a pair with: node scripts/generate-vapid-keys.mjs
# The private key belongs in Supabase Edge Function secrets, never here.
VITE_VAPID_PUBLIC_KEY=
